# Model API credentials passed into the task container (only the hosts in
# proxy/allowlist.txt are reachable from it).
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
# Command run-agent.sh invokes inside the container; the prompt is appended.
AGENT_CMD=claude -p --dangerously-skip-permissions
