+  //mario-eval: RDRAM lines (16 bytes) ever transferred by any bus device.
+  //Only maintained in homebrew mode, alongside the profile counters above.
+  //When armed, the bitmap is cleared the first time the CPU executes at
+  //resetPC (the game's entry point), so boot-time RDRAM clearing by IPL3
+  //is not attributed to the game.
+  struct Footprint {
+    static constexpr u32 LineShift = 4;
+    std::vector<u8> bits = std::vector<u8>((8_MiB >> LineShift) / 8, 0);
+    u32 resetPC = 0;
+    bool armed = false;
+
+    auto reset() -> void { std::fill(bits.begin(), bits.end(), 0); }
+
+    auto mark(u32 address, u32 size) -> void {
+      u32 first = address >> LineShift;
+      u32 last = (address + size - 1) >> LineShift;
+      for(u32 line = first; line <= last && line < bits.size() * 8; line++) {
+        bits[line >> 3] |= 1 << (line & 7);
+      }
+    }
+
+    auto lines() const -> u64 {
+      u64 count = 0;
+      for(auto byte : bits) count += __builtin_popcount(byte);
+      return count;
+    }
+
+    auto highestLine() const -> s64 {
+      for(s64 index = bits.size() - 1; index >= 0; index--) {
+        if(bits[index]) return index * 8 + (31 - __builtin_clz(bits[index]));
+      }
+      return -1;
+    }
+  } footprint;
+
