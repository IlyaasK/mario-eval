+auto RDP::Profile::command(const u32* words, u32 length) -> void {
+  u32 code = (words[0] >> 24) & 63;
+  commands++;
+  cycles += length;
+
+  auto markRdram = [](u32 addr, u32 bytes, RBusDevice dev, bool write) {
+    if(!bytes || addr >= rdram.ram.size) return;
+    u32 avail = rdram.ram.size - addr;
+    if(bytes > avail) bytes = avail;
+    if(write) rdram.profile.metrics[(u32)dev].writes += bytes;
+    else      rdram.profile.metrics[(u32)dev].reads  += bytes;
+    rdram.footprint.mark(addr, bytes);
+  };
+
+  auto sext14 = [](u32 v) -> s32 {
+    v &= 0x3fffu;
+    return (v & 0x2000u) ? (s32)(v | ~0x3fffu) : (s32)v;
+  };
+  auto sext27 = [](s64 v) -> s32 {
+    u32 u = (u32)v & 0x07ff'ffffu;
+    return (u & 0x0400'0000u) ? (s32)(u | ~0x07ff'ffffu) : (s32)u;
+  };
+  auto sext28 = [](u32 v) -> s32 {
+    v &= 0x0fff'ffffu;
+    return (v & 0x0800'0000u) ? (s32)(v | ~0x0fff'ffffu) : (s32)v;
+  };
+  auto quantizeX = [](s32 x) -> s32 {
+    s32 sticky = (x & 0xfff) ? 1 : 0;
+    return (x >> 12) | sticky;
+  };
+
+  auto rasterize = [&](s32 xh, s32 xm, s32 xl, s32 yh, s32 ym, s32 yl,
+                       s32 dxhdy, s32 dxmdy, s32 dxldy, bool flip) {
+    s32 yloSub = std::max(yh, state.scissorYLo);
+    s32 yhiSub = std::min(yl, state.scissorYHi);
+    if(yhiSub <= yloSub) return;
+    s32 minY = std::max(0, yloSub >> 2);
+    s32 maxY = std::min(1023, (yhiSub - 1) >> 2);
+    s32 yhBase = yh & ~3;
+    s32 loScissor = state.scissorXLo << 1;
+    s32 hiScissor = state.scissorXHi << 1;
+    bool fillOrCopy = state.cycleType >= 2;
+    u32 bpp = (state.colorSize == 3) ? 4 : (state.colorSize == 2 ? 2 : 1);
+
+    for(s32 y = minY; y <= maxY; y++) {
+      if(state.interlace && ((y & 1) != (state.keepOdd ? 1 : 0))) continue;
+      s32 minLeft = 0x7fff'ffff, maxRight = -0x7fff'ffff;
+      bool anyValid = false;
+      for(s32 sub = 0; sub < 4; sub++) {
+        s32 ys = (y << 2) + sub;
+        if(ys < yloSub || ys >= yhiSub) continue;
+        s32 xhSub = sext27((s64)xh + (s64)(ys - yhBase) * dxhdy);
+        s64 xlRaw = (ys < ym) ? ((s64)xm + (s64)(ys - yhBase) * dxmdy) : ((s64)xl + (s64)(ys - ym) * dxldy);
+        s32 xlSub = sext27(xlRaw);
+        s32 xhs = quantizeX(xhSub), xls = quantizeX(xlSub);
+        s32 xlft = flip ? xhs : xls;
+        s32 xrgt = flip ? xls : xhs;
+        if((xlft >> 1) > (xrgt >> 1)) continue;
+        if(std::min(xlft, xrgt) >= hiScissor || std::max(xlft, xrgt) < loScissor) continue;
+        xlft = std::clamp(xlft, loScissor, hiScissor);
+        xrgt = std::clamp(xrgt, loScissor, hiScissor);
+        minLeft = std::min(minLeft, xlft);
+        maxRight = std::max(maxRight, xrgt);
+        anyValid = true;
+      }
+      if(!anyValid) continue;
+      s32 startX = std::max(0, minLeft >> 3);
+      s32 endX = std::min((s32)state.colorWidth - 1, fillOrCopy ? (maxRight >> 3) : ((maxRight - 1) >> 3));
+      if(endX < startX) continue;
+      u32 px = (u32)(endX - startX + 1);
+      pixels += px;
+      u32 cAddr = state.colorAddr + ((u32)y * state.colorWidth + (u32)startX) * bpp;
+      u32 cBytes = px * bpp;
+      if(fillOrCopy) {
+        u32 pxPerCycle = (bpp == 4) ? 2 : 4;
+        u64 sc = 2 + (px + pxPerCycle - 1) / pxPerCycle;
+        fillCycles += sc;
+        cycles += sc;
+        markRdram(cAddr, cBytes, RBusDevice::DP_DRAW, true);
+      } else {
+        u64 sc = 4 + (u64)px * (state.cycleType == 1 ? 2 : 1);
+        if(state.imageRead) {
+          sc += px;
+          markRdram(cAddr, cBytes, RBusDevice::DP_DRAW, false);
+        }
+        markRdram(cAddr, cBytes, RBusDevice::DP_DRAW, true);
+        u32 zAddr = state.zAddr + ((u32)y * state.colorWidth + (u32)startX) * 2;
+        if(state.zCompare) {
+          sc += px;
+          markRdram(zAddr, px * 2, RBusDevice::DP_DRAW, false);
+        }
+        if(state.zUpdate) {
+          sc += (px + 1) / 2;
+          markRdram(zAddr, px * 2, RBusDevice::DP_DRAW, true);
+        }
+        fillCycles += sc;
+        cycles += sc;
+      }
+    }
+  };
+
+  switch(code) {
+  case 0x08: case 0x09: case 0x0a: case 0x0b:
+  case 0x0c: case 0x0d: case 0x0e: case 0x0f: {
+    triangles++;
+    cycles += 10;
+    bool flip = (words[0] & 0x80'0000u) != 0;
+    s32 yl = sext14(words[0]);
+    s32 ym = sext14(words[1] >> 16);
+    s32 yh = sext14(words[1]);
+    s32 xl = sext28(words[2]) >> 1;
+    s32 dxldy = sext28(words[3] >> 2) >> 1;
+    s32 xh = sext28(words[4]) >> 1;
+    s32 dxhdy = sext28(words[5] >> 2) >> 1;
+    s32 xm = sext28(words[6]) >> 1;
+    s32 dxmdy = sext28(words[7] >> 2) >> 1;
+    rasterize(xh, xm, xl, yh, ym, yl, dxhdy, dxmdy, dxldy, flip);
+  } break;
+
+  case 0x24: case 0x25: case 0x36: {
+    rectangles++;
+    cycles += 4;
+    s32 xl = (s32)((words[0] >> 12) & 0xfff);
+    s32 yl = (s32)((words[0] >>  0) & 0xfff);
+    s32 xh = (s32)((words[1] >> 12) & 0xfff);
+    s32 yh = (s32)((words[1] >>  0) & 0xfff);
+    if(state.cycleType >= 2) yl |= 3;
+    rasterize(xh << 13, xl << 13, xl << 13, yh, yl, yl, 0, 0, 0, true);
+  } break;
+
+  case 0x26: case 0x27: case 0x28: case 0x29: {
+    syncs++;
+    u64 sc = (code == 0x29) ? 50 : (code == 0x27 ? 24 : 16);
+    syncCycles += sc;
+    cycles += sc;
+  } break;
+
+  case 0x2d: {
+    state.scissorXLo = (s32)((words[0] >> 12) & 0xfff);
+    state.scissorYLo = (s32)((words[0] >>  0) & 0xfff);
+    state.scissorXHi = (s32)((words[1] >> 12) & 0xfff);
+    state.scissorYHi = (s32)((words[1] >>  0) & 0xfff);
+    state.interlace  = (words[1] & (1u << 25)) != 0;
+    state.keepOdd    = (words[1] & (1u << 24)) != 0;
+  } break;
+
+  case 0x2f: {
+    state.cycleType = (words[0] >> 20) & 3;
+    state.imageRead = (words[1] & (1u << 6)) != 0;
+    state.zUpdate   = (words[1] & (1u << 5)) != 0;
+    state.zCompare  = (words[1] & (1u << 4)) != 0;
+  } break;
+
+  case 0x30: { // LoadTLUT
+    u32 slo = (words[0] >> 12) & 0xfff, tlo = words[0] & 0xfff;
+    u32 shi = (words[1] >> 12) & 0xfff, thi = words[1] & 0xfff;
+    if((thi >> 2) >= (tlo >> 2)) {
+      u32 count = (((shi >> 2) - (slo >> 2)) + 1) & 0xfff;
+      if(count) {
+        u32 bytes = (count * 2 + 7) & ~7u;
+        u32 addr = state.texAddr + ((slo >> 2) + state.texWidth * (tlo >> 2)) * 2;
+        markRdram(addr, bytes, RBusDevice::DP_DMA, false);
+        tmemLoads++;
+        tmemBytes += bytes;
+        u64 tc = 12 + count;
+        tmemCycles += tc;
+        cycles += tc;
+      }
+    }
+  } break;
+
+  case 0x33: { // LoadBlock
+    u32 slo = (words[0] >> 12) & 0xfff, tlo = words[0] & 0xfff;
+    u32 shi = (words[1] >> 12) & 0xfff;
+    u32 texels = ((shi - slo) + 1) & 0xfff;
+    if(texels > 0 && texels <= 2048) {
+      u32 bptBits = 4u << state.texSize;
+      u32 bytes = ((texels * bptBits + 63u) >> 6) << 3;
+      u32 addr = state.texAddr + ((slo + state.texWidth * tlo) * bptBits) / 8u;
+      markRdram(addr, bytes, RBusDevice::DP_DMA, false);
+      tmemLoads++;
+      tmemBytes += bytes;
+      u64 tc = 12 + bytes / 8;
+      tmemCycles += tc;
+      cycles += tc;
+    }
+  } break;
+
+  case 0x34: { // LoadTile
+    u32 slo = (words[0] >> 12) & 0xfff, tlo = words[0] & 0xfff;
+    u32 shi = (words[1] >> 12) & 0xfff, thi = words[1] & 0xfff;
+    if((thi >> 2) >= (tlo >> 2)) {
+      u32 w = (((shi >> 2) - (slo >> 2)) + 1) & 0xfff;
+      u32 h = ((thi >> 2) - (tlo >> 2)) + 1;
+      if(w > 0 && h <= 1024) {
+        u32 bptBits = 4u << state.texSize;
+        u32 rowBytes = ((w * bptBits + 63u) >> 6) << 3;
+        u32 total = 0;
+        for(u32 r = 0; r < h; r++) {
+          u32 rowAddr = state.texAddr + ((((tlo >> 2) + r) * state.texWidth + (slo >> 2)) * bptBits) / 8u;
+          markRdram(rowAddr, rowBytes, RBusDevice::DP_DMA, false);
+          total += rowBytes;
+        }
+        tmemLoads++;
+        tmemBytes += total;
+        u64 tc = 12 + total / 8;
+        tmemCycles += tc;
+        cycles += tc;
+      }
+    }
+  } break;
+
+  case 0x3d: {
+    state.texSize   = (words[0] >> 19) & 3;
+    state.texWidth  = (words[0] & 0x3ff) + 1;
+    state.texAddr   = words[1] & 0x00ff'ffffu;
+  } break;
+
+  case 0x3e: {
+    state.zAddr     = words[1] & 0x00ff'ffffu;
+  } break;
+
+  case 0x3f: {
+    state.colorSize  = (words[0] >> 19) & 3;
+    state.colorWidth = (words[0] & 0x3ff) + 1;
+    state.colorAddr  = words[1] & 0x00ff'ffffu;
+  } break;
+  }
+}
+
 }
