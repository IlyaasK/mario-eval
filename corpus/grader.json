{
  "version": "2.0",
  "target": "pips-garden",
  "contract": "pips-garden",
  "rom": "pips-garden.z64",
  "elf": "build/pips-garden.elf",
  "build_cmd": ["make"],
  "play_build_cmd": ["make", "PLAY=1"],
  "o2_reference_patch": "../calibration/r1-o2-ieee.patch",
  "protected_files": ["src/mev.c", "src/mev.h"],
  "allowed_play_guards": {
    "src/main.c": 2
  },
  "elf_harness_check": {
    "required_text_symbols": [
      "mev_init",
      "mev_read_pad",
      "mev_end_frame"
    ],
    "forbid_wrap_prefix": "__wrap_mev_"
  },
  "frames": 240,
  "build_timeout_s": 600,
  "max_fields_factor": 4.0,
  "run_timeout_s": 1800,
  "video": {
    "channel_tolerance": 2,
    "max_bad_fraction": 0.002
  },
  "accepted_visual_variants": [
    {
      "id": "full-detail",
      "patch": "variants/full-detail.patch",
      "policy": "Characters may always be drawn at full detail instead of switching to lower-detail models with camera distance (as Kaze Emanuar does for Mario in SM64). Judged equal or better looking; gameplay and audio must be unchanged."
    }
  ],
  "audio": {
    "min_snr_db": 40.0,
    "min_frame_snr_db": 20.0,
    "silence_rms": 64.0,
    "silence_max_abs": 256
  },
  "hardware": {
    "rdram_bytes": 4194304,
    "max_dcache_coherence_errors": 0
  },
  "profiles": {
    "console": { "metric": "est_console_ms",  "max_workload_regression": 0.05, "footprint_budget": 0.05 },
    "speed":   { "metric": "cpu_effective_cycles", "max_workload_regression": 0.05, "rdp_budget": 0.05 },
    "rdp":     { "metric": "rdp_busy",        "max_workload_regression": 0.05, "speed_budget": 0.05 },
    "rsp":     { "metric": "rsp_busy",        "max_workload_regression": 0.05, "speed_budget": 0.05 },
    "traffic": { "metric": "rdram_bytes",     "max_workload_regression": 0.05, "speed_budget": 0.05 },
    "memory":  { "metric": "footprint_bytes", "max_workload_regression": 0.0,  "speed_budget": 0.05 }
  },
  "workloads": [
    { "id": "meadow",   "split": "public", "replay": "replays/public/meadow.txt" },
    { "id": "fortress", "split": "public", "replay": "replays/public/fortress.txt" },
    { "id": "storm",    "split": "public", "replay": "replays/public/storm.txt" },
    { "id": "concert",  "split": "public", "replay": "replays/public/concert.txt" }
  ]
}
