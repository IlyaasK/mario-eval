 #include <string.h>
 #include "game.h"
 
+#define SINE_TABLE 1024
+static float sine_table[SINE_TABLE + 1];
+
 void synth_init(void)
 {
     memset(world.voices, 0, sizeof(world.voices));
+    for (int i = 0; i <= SINE_TABLE; i++)
+        sine_table[i] = sinf((float)i * (6.2831853f / SINE_TABLE));
 }
 
+// Linear interpolation into a one-period table; phase is in [0, 1).
+static float table_sine(float phase)
+{
+    float x = phase * SINE_TABLE;
+    int i = (int)x;
+    float f = x - (float)i;
+    return sine_table[i] + (sine_table[i + 1] - sine_table[i]) * f;
+}
