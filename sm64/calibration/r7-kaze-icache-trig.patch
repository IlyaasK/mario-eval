+        case 0:  *outSin = sn;        *outCos = co;        break;
+        case 1:  *outSin = co;        *outCos = 0.0f - sn; break;
+        case 2:  *outSin = 0.0f - sn; *outCos = 0.0f - co; break;
+        default: *outSin = 0.0f - co; *outCos = sn;        break;
+    }
