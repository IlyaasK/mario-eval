+static s32 is_batchable_coin_dl(const void *dl) {
+    const Gfx *vdl;
+    if ((((uintptr_t) dl) >> 24) != 0x03U) {
+        return FALSE;
+    }
+    vdl = (const Gfx *) segmented_to_virtual(dl);
+    return ((vdl[0].words.w0 >> 24) == (u32) (G_SETTIMG & 0xFF))
+        && (vdl[1].words.w0 == ((u32) (G_DL & 0xFF) << 24))
+        && ((vdl[2].words.w0 >> 24) == (u32) (G_VTX & 0xFF))
+        && (vdl[3].words.w0 == (((u32) (G_DL & 0xFF) << 24) | 0x00010000U));
+}
