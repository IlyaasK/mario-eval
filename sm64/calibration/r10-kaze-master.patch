diff --git c/Makefile i/Makefile
index 074d3be..84d1ddb 100644
--- c/Makefile
+++ i/Makefile
@@ -23,7 +23,7 @@ TARGET_N64 ?= 1
 #   ido - uses the SGI IRIS Development Option compiler, which is used to build
 #         an original matching N64 ROM
 #   gcc - uses the GNU C Compiler
-COMPILER ?= ido
+COMPILER ?= gcc
 $(eval $(call validate-option,COMPILER,ido gcc))
 
 
@@ -39,13 +39,13 @@ $(eval $(call validate-option,VERSION,jp us eu sh cn))
 ifeq      ($(VERSION),jp)
   DEFINES   += VERSION_JP=1
   OPT_FLAGS := -g
-  GRUCODE   ?= f3d_old
+  GRUCODE   ?= f3dex2
   VERSION_JP_US  ?= true
   VERSION_SH_CN  ?= false
 else ifeq ($(VERSION),us)
   DEFINES   += VERSION_US=1
   OPT_FLAGS := -g
-  GRUCODE   ?= f3d_old
+  GRUCODE   ?= f3dex2
   VERSION_JP_US  ?= true
   VERSION_SH_CN  ?= false
 else ifeq ($(VERSION),eu)
@@ -112,7 +112,7 @@ ifeq      ($(COMPILER),ido)
 else ifeq ($(COMPILER),gcc)
   NON_MATCHING := 1
   MIPSISET     := -mips3
-  OPT_FLAGS    := -O2 -fno-fast-math
+  OPT_FLAGS    := -O2 -fno-fast-math -fno-math-errno -fno-unroll-loops -fno-peel-loops -fno-bit-tests --param=case-values-threshold=15
 endif
 
 
@@ -255,6 +255,14 @@ include Makefile.split
 # Source code files
 LEVEL_C_FILES     := $(wildcard levels/*/leveldata.c) $(wildcard levels/*/script.c) $(wildcard levels/*/geo.c)
 C_FILES           := $(foreach dir,$(SRC_DIRS),$(wildcard $(dir)/*.c)) $(LEVEL_C_FILES)
+# US audio is compiled as one translation unit without changing playback paths.
+ifeq ($(VERSION),us)
+  C_FILES := $(filter-out src/audio/globals_start.c src/audio/data.c src/audio/heap.c \
+    src/audio/load.c src/audio/synthesis.c src/audio/external.c src/audio/seqplayer.c \
+    src/audio/effects.c src/audio/playback.c,$(C_FILES))
+else
+  C_FILES := $(filter-out src/audio/sequence_unity.c,$(C_FILES))
+endif
 S_FILES           := $(foreach dir,$(SRC_DIRS),$(wildcard $(dir)/*.s))
 ULTRA_C_FILES     := $(foreach dir,$(ULTRA_SRC_DIRS),$(wildcard $(dir)/*.c))
 GODDARD_C_FILES   := $(foreach dir,$(GODDARD_SRC_DIRS),$(wildcard $(dir)/*.c))
@@ -879,8 +887,45 @@ $(BUILD_DIR)/src/audio/%.copt: $(BUILD_DIR)/src/audio/%.acpp
 	$(COPT) -signed -I=$< -CMP=$@ -cp=i -scalaroptimize=1 $(COPTFLAGS)
 $(BUILD_DIR)/src/audio/seqplayer.copt: COPTFLAGS := -inline_manual
 
+else ifeq ($(COMPILER),gcc)
+  HOT_GCC_OPT  := -O3 -fno-fast-math -fno-math-errno -fno-unroll-loops -fno-peel-loops -fno-bit-tests --param=case-values-threshold=15
+  COLD_GCC_OPT := -Os -fno-fast-math -fno-math-errno -fno-bit-tests --param=case-values-threshold=15
+  # ultrasm64 (FazanaJ) 8a20ba05 "Os libultra" (NL) / 0ab727b8 "Os": the fork compiles the
+  # whole libultra from source at -Os. r10's per-file libultra flags (-O3 for gu*/al*, -O2,
+  # -mno-abicalls -mips2 ...) sit in the ifeq ($(COMPILER),ido) branch (Makefile:748-853) and
+  # are therefore dead in the gcc build, so r10's libultra actually compiles with the game
+  # default OPT_FLAGS. This applies the cold flag string to libultra only (ULTRA_C_FILES =
+  # lib/src/*.c + lib/src/math/*.c, which excludes lib/src/libgcc).
+  $(patsubst %.c,$(BUILD_DIR)/%.o,$(ULTRA_C_FILES)): OPT_FLAGS := $(COLD_GCC_OPT)
+  $(BUILD_DIR)/src/engine/math_util.o:          OPT_FLAGS := $(COLD_GCC_OPT)
+  $(BUILD_DIR)/src/engine/surface_collision.o:  OPT_FLAGS := $(COLD_GCC_OPT)
+  $(BUILD_DIR)/src/game/rendering_graph_node.o: OPT_FLAGS := $(COLD_GCC_OPT)
+  $(BUILD_DIR)/src/game/shadow.o:               OPT_FLAGS := $(COLD_GCC_OPT)
+  $(BUILD_DIR)/src/audio/%.o:                   OPT_FLAGS := $(COLD_GCC_OPT) -ffunction-sections
+  $(BUILD_DIR)/src/game/behavior_actions.o:     OPT_FLAGS := $(COLD_GCC_OPT)
+  $(BUILD_DIR)/src/game/obj_behaviors.o:        OPT_FLAGS := $(COLD_GCC_OPT)
+  $(BUILD_DIR)/src/game/obj_behaviors_2.o:      OPT_FLAGS := $(COLD_GCC_OPT)
+  $(BUILD_DIR)/src/game/object_helpers.o:       OPT_FLAGS := $(COLD_GCC_OPT)
+  $(BUILD_DIR)/src/game/mario_actions_%.o:      OPT_FLAGS := $(COLD_GCC_OPT)
+  $(BUILD_DIR)/src/game/camera.o:               OPT_FLAGS := $(COLD_GCC_OPT)
+  $(BUILD_DIR)/src/game/interaction.o:          OPT_FLAGS := $(COLD_GCC_OPT)
+  $(BUILD_DIR)/src/game/ingame_menu.o:          OPT_FLAGS := $(COLD_GCC_OPT)
+  $(BUILD_DIR)/src/game/print.o:                OPT_FLAGS := $(COLD_GCC_OPT)
+  $(BUILD_DIR)/src/game/crash_screen.o:         OPT_FLAGS := $(COLD_GCC_OPT)
+  $(BUILD_DIR)/src/game/debug.o:                OPT_FLAGS := $(COLD_GCC_OPT)
+  $(BUILD_DIR)/src/game/debug_course.o:         OPT_FLAGS := $(COLD_GCC_OPT)
+  $(BUILD_DIR)/src/game/save_file.o:            OPT_FLAGS := $(COLD_GCC_OPT)
+  $(BUILD_DIR)/src/audio/heap.o:                OPT_FLAGS := $(COLD_GCC_OPT)
+  $(BUILD_DIR)/src/menu/%.o:                    OPT_FLAGS := $(COLD_GCC_OPT)
+  $(BUILD_DIR)/src/goddard/%.o:                 OPT_FLAGS := $(COLD_GCC_OPT)
 endif
 
+# Rainbow Ride decoration pieces baked into level display lists (Kaze Emanuar)
+$(BUILD_DIR)/levels/rr/baked_statics.inc.c: tools/bake_rr_statics.py levels/rr/script.c
+	$(call print,Baking:,levels/rr,$@)
+	$(V)$(PYTHON) tools/bake_rr_statics.py $@
+$(BUILD_DIR)/levels/rr/leveldata.o: $(BUILD_DIR)/levels/rr/baked_statics.inc.c
+
 # Assemble assembly code
 $(BUILD_DIR)/%.o: %.s
 	$(call print,Assembling:,$<,$@)
@@ -892,9 +937,11 @@ $(BUILD_DIR)/rsp/%.bin $(BUILD_DIR)/rsp/%_data.bin: rsp/%.s
 	$(V)$(RSPASM) -sym $@.sym $(RSPASMFLAGS) -strequ CODE_FILE $(BUILD_DIR)/rsp/$*.bin -strequ DATA_FILE $(BUILD_DIR)/rsp/$*_data.bin $<
 
 # Run linker script through the C preprocessor
+# (the script must see the same target configuration as the code: config.h's
+# BORDER_HEIGHT is 8 on the N64 and 0 elsewhere)
 $(BUILD_DIR)/$(LD_SCRIPT): $(LD_SCRIPT)
 	$(call print,Preprocessing linker script:,$<,$@)
-	$(V)$(CPP) $(CPPFLAGS) -DBUILD_DIR=$(BUILD_DIR) -MMD -MP -MT $@ -MF $@.d -o $@ $<
+	$(V)$(CPP) $(CPPFLAGS) $(if $(filter 1,$(TARGET_N64)),-DTARGET_N64,) -DBUILD_DIR=$(BUILD_DIR) -MMD -MP -MT $@ -MF $@.d -o $@ $<
 
 # Link libultra
 $(BUILD_DIR)/libultra.a: $(ULTRA_O_FILES)
