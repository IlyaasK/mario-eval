+#define FRAMEBUFFER_STRIDE_WORDS ((SCREEN_HEIGHT - BORDER_HEIGHT) * SCREEN_WIDTH)
+
+extern u16 gFramebuffers[SEG_FRAMEBUFFERS_SIZE / sizeof(u16)];
