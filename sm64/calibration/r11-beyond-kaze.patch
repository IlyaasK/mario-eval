+  $(BUILD_DIR)/src/game/camera.o:               OPT_FLAGS := $(COLD_GCC_OPT)
+  $(BUILD_DIR)/src/game/interaction.o:          OPT_FLAGS := $(COLD_GCC_OPT)
+  $(BUILD_DIR)/src/game/ingame_menu.o:          OPT_FLAGS := $(COLD_GCC_OPT)
+  $(BUILD_DIR)/src/game/print.o:                OPT_FLAGS := $(COLD_GCC_OPT)
+  $(BUILD_DIR)/src/game/crash_screen.o:         OPT_FLAGS := $(COLD_GCC_OPT)
+  $(BUILD_DIR)/src/game/debug.o:                OPT_FLAGS := $(COLD_GCC_OPT)
+  $(BUILD_DIR)/src/game/debug_course.o:         OPT_FLAGS := $(COLD_GCC_OPT)
+  $(BUILD_DIR)/src/game/save_file.o:            OPT_FLAGS := $(COLD_GCC_OPT)
+  $(BUILD_DIR)/src/audio/heap.o:                OPT_FLAGS := $(COLD_GCC_OPT)
+  $(BUILD_DIR)/src/menu/%.o:                    OPT_FLAGS := $(COLD_GCC_OPT)
