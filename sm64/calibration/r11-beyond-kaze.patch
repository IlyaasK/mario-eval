@@ -142,15 +142,19 @@ struct ObjectNode {
 // NOTE: Since ObjectNode is the first member of Object, it is difficult to determine
 // whether some of these pointers point to ObjectNode or Object.
 
+// Member order is chosen for the 16-byte D-cache lines (gObjectPool is 16-byte
+// aligned): every object-list walk needs next/prev and activeFlags, so they
