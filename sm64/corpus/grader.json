  "elf_harness_check": {
    "required_text_symbols": [
      "mev_init",
      "mev_entry_script",
      "mev_select_boot_level",
      "mev_read_pad_sync",
      "mev_step_audio",
      "mev_observe_and_end_frame"
    ],
    "required_data_sizes": {
      "sMevObs": 4224
    },
    "min_data_sizes": {
      "sMevAudioStorage": 4096
    },
    "forbid_wrap_prefix": "__wrap_mev_",
    "isv_upper_imm": "0xb3ff",
    "mev_object": "build/us/src/game/mev.o"
  },
  "idle_symbols": ["thread1_idle"],
  "reward_log2_scale": 4.0,
  "frames": 240,
  "build_timeout_s": 900,
  "max_fields_factor": 4.0,
  "run_timeout_s": 1800,
  "gameplay": {
    "mode": "player_equivalence",
    "exact_fields": ["frame", "level_area", "mario_stats", "mario_action", "actor_count"],
    "window_exact_fields": [],
    "window_frames": 0,
    "float_tolerances": {
      "mario_pos": 0.01,
      "mario_vel": 0.01,
      "mario_floor_height": 0.01,
      "cam_pos": 0.02,
      "cam_focus": 0.02
    },
    "actor_tolerance": 0.1,
    "actor_radius": 2000
  },
  "video": {
    "channel_tolerance": 2,
    "max_bad_fraction": 0.002
  },
  "accepted_visual_variants": [
    {
      "id": "full-detail",
      "patch": "variants/full-detail.patch",
      "subsumed_by": ["no-lod"],
      "policy": "Mario may always be drawn with his high-polygon model instead of switching to medium/low-polygon LOD models at distance (as Kaze Emanuar does in Return to Yoshi's Island). Judged equal or better looking; gameplay and audio must be unchanged. The change is only Mario's level of detail, which no-lod already removes, so combinations with no-lod render exactly like no-lod and are not precomputed separately (verified against every combination on every public route)."
    },
    {
      "id": "ra-zb-opa",
      "patch": "variants/ra-zb-opa.patch",
      "policy": "Opaque layers in rendering_graph_node.c may use SGI's official G_RM_RA_ZB_OPA_SURF / G_RM_RA_OPA_SURF reduced-aliasing modes (keeping AA_EN VI silhouette coverage while dropping IM_RD per-pixel framebuffer reads, as used in later N64 titles and Kaze Emanuar's SM64 optimizations)."
    },
    {
      "id": "f3dex2",
      "patch": "variants/f3dex2.patch",
      "policy": "The game may use Nintendo's later F3DEX2 graphics microcode (shipped with the libultra SDK and used by Kaze Emanuar's SM64 work) instead of the original Fast3D. Its vertex transform and clipping round slightly differently, moving some triangle edges by a sub-pixel; nothing is added or removed."
    },
    {
      "id": "no-lod",
      "patch": "variants/no-lod.patch",
      "policy": "Level-of-detail switching may be removed everywhere, as Kaze Emanuar does in \"How Optimizations made Mario 64 SLOWER\": the near, full-detail model is always drawn at any distance and the far low-detail alternatives never are, so nothing pops in or swaps model. Gameplay and audio must be unchanged."
    },
    {
      "id": "rr-statics",
      "patch": "variants/rr-statics.patch",
      "workloads": ["rr"],
      "policy": "Rainbow Ride's 14 static decoration pieces (special_level_geo_03/04/07/09/0A/0B/0C/0D/10-15) may be drawn as part of the level mesh (each piece's own display list under a static translation matrix) instead of being spawned as objects, exactly the set Kaze Emanuar merged in his \"How Optimizations made Mario 64 SLOWER\" code release. The same triangles at the same places; draw order and vertex rounding may move edge pixels."
    }
  ],
  "audio": {
    "min_snr_db": 40.0,
    "min_frame_snr_db": 20.0,
    "silence_rms": 64.0,
    "silence_max_abs": 256,
    "sample_rate": 32000,
    "channels": 2,
    "min_logmel_score": 0.95,
    "min_logmel_frame_score": 0.75,
    "max_rms_ratio_err": 0.15
  },
  "section_weights": {
    "public": 0.40,
    "heldout_scripted": 0.50,
    "heldout_mash": 0.10
  },
  "hardware": {
    "rdram_bytes": 4194304,
    "max_dcache_coherence_errors_per_frame": 1.05
  },
  "profiles": {
    "console": { "metric": "est_console_ms",  "max_workload_regression": 0.05, "footprint_budget": 0.05 },
    "stutter": { "metric": "est_console_p99_ms", "max_workload_regression": 0.05, "footprint_budget": 0.05 },
    "speed":   { "metric": "cpu_effective_cycles", "max_workload_regression": 0.05, "rdp_budget": 0.05 },
    "rdp":     { "metric": "rdp_busy",        "max_workload_regression": 0.05, "speed_budget": 0.05 },
    "rsp":     { "metric": "rsp_busy",        "max_workload_regression": 0.05, "speed_budget": 0.05 },
    "traffic": { "metric": "rdram_bytes",     "max_workload_regression": 0.05, "speed_budget": 0.05 },
    "memory":  { "metric": "footprint_bytes", "max_workload_regression": 0.0,  "speed_budget": 0.05 }
  },
  "workloads": [
    { "id": "bob",   "split": "public", "replay": "replays/public/bob.txt" },
    { "id": "wf",    "split": "public", "replay": "replays/public/wf.txt" },
    { "id": "jrb",   "split": "public", "replay": "replays/public/jrb.txt" },
    { "id": "ddd",   "split": "public", "replay": "replays/public/ddd.txt" },
