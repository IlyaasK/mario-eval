# Run outputs: keep only calibration and published agent summaries (used by the site).
results/*
!results/sm64-calibration/
results/sm64-calibration/*/*
!results/sm64-calibration/*/summary.json
!results/sm64-trial-calibration/
results/sm64-trial-calibration/*/*
!results/sm64-trial-calibration/*/summary.json
!results/agents/
results/agents/*/*
!results/agents/*/summary.json
!results/agents/*/trajectory.json
!results/agents/*/meta.json
# Baseline reference cache & compiled local C++ shared objects.
cache/
grader/*.so
# Build products.
site/dist/
artifacts/
# Never commit anything derived from a Nintendo ROM.
sm64/decomp/
*.z64
*.n64
*.v64
# Local agent environment secrets.
quickstart/.env
# Python bytecode.
__pycache__/
